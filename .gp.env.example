# Copy to .gp.env and adjust per user.
GP_1P_ITEM="Company VPN"
# GP_1P_VAULT="Private"

# Use either your GlobalProtect portal host with GP_INTERFACE="portal",
# or a direct gateway host with GP_INTERFACE="gateway".
VPN_HOST="vpn.example.com"
GP_INTERFACE="gateway"

# Leave blank when VPN_HOST is already a gateway.
# For portal mode, set this to the gateway/authgroup name shown by openconnect.
GP_AUTHGROUP=""

VPN_USER="your.name@example.com"
GP_MFA_METHOD="push"
GP_MS_STAY_SIGNED_IN=yes
