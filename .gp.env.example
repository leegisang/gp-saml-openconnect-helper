# Copy to .gp.env and adjust per user. Keep .gp.env local.

# 1Password login item. It should contain username, password, and a one-time
# password field when GP_MFA_METHOD is "verification-code".
GP_1P_ITEM="Company VPN"
# GP_1P_VAULT="Private"

# Default official-app flow.
GP_MFA_METHOD="verification-code"
GP_MS_STAY_SIGNED_IN=yes

# Chrome external-app callback opened after SAML succeeds. Defaults are usually
# enough; set origins when your portal host differs from VPN_HOST.
VPN_HOST="vpn.example.com"
# GP_APP_CALLBACK_PROTOCOL="globalprotectcallback"
# GP_APP_CALLBACK_ORIGINS="https://connect.example.com"
# GP_APP_PLAYWRIGHT_PROFILE=".gp-app-playwright-profile"
