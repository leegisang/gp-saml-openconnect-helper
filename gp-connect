#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -d "$DIR/node_modules/playwright-core" ]]; then
  echo "Missing dependency: playwright-core"
  echo "Run this first:"
  echo "  cd '$DIR' && npm install"
  exit 1
fi

exec node "$DIR/gp-saml-playwright.mjs"
